# deskless 클러스터 설정 — ./deskless.sh(Windows deskless.cmd)가 읽는다. 키의 자세한 뜻은 docs/kubernetes.md
# 앱 값은 backend/.env · frontend/.env.production(없으면 frontend/.env) — 여기 다시 적지 않는다
# 기본값 = 이 PC 로컬(k3d) — cp .env.example .env 만으로 돈다. 다른 PC 는 "이 PC" 절과 LOCAL_* 만 고친다(PC 포트를 바꾸면 ./deskless.sh reset)
# (필수) 가 비었거나 새로 생긴 키가 .env 에 없으면 up 이 시작 전에 멈춘다
# 운영 서버는 비밀번호 전부 새로 · *_EXPOSE=0 · 공개 주소 · 도메인 · IMAGE_SOURCE=registry — docs/kubernetes.md "운영 서버"

# ── 이 PC ──────────────────────────────────
# Git Bash · Docker Desktop 경로(Windows — Docker 가 꺼져 있으면 up 이 켠다)
GIT_BASH=C:\Program Files\Git\bin\bash.exe
DOCKER_DESKTOP_EXE=C:\Program Files\Docker\Docker\Docker Desktop.exe
# k3s 추가 인자 — cgroup v1 PC 에 필요(docker info 의 Cgroup Version 이 2 면 비운다)
LOCAL_K3S_ARGS=--kubelet-arg=fail-cgroupv1=false@server:*
# 기다리는 시간 — Docker 켜기 · 노드 준비(초) / Helm · 작업(분, 서버도 쓴다)
LOCAL_START_TIMEOUT_SECONDS=180
WAIT_TIMEOUT_MINUTES=15

# ── 클러스터 ───────────────────────────────
# (필수) kubectl 컨텍스트 — k3d-<이름> 이면 로컬(없으면 만든다), 운영 서버는 default
KUBE_CONTEXT=k3d-deskless
# kubectl API PC 포트(로컬)
LOCAL_API_PORT=6550
# 노드 데이터 폴더 · 로컬은 그 자리에 붙는 Docker 볼륨(클러스터를 지워도 남는다)
INFRA_DATA_DIR=/var/lib/deskless
LOCAL_DATA_VOLUME=deskless-infra-data
# 네트워크 격리(0 = 끔 — 문제를 가려 볼 때만)
NETWORK_POLICY=1
# 자동 증설 기준 — CPU 코어 1개의 %(모든 앱 공통)
AUTOSCALE_CPU_PERCENT=70
# (운영) Ingress 종류 — 비우면 클러스터 기본(k3s Traefik)
INGRESS_CLASS=

# ── 이미지 ─────────────────────────────────
# build = 이 컴퓨터에서 빌드 · registry = GHCR 에서 받기(운영)
IMAGE_SOURCE=build
# GHCR 저장소 · 계정 · 키(classic — 올리기 write:packages · 받기 read:packages). 쓰는 명령(push · registry)에서만 확인한다
IMAGE_REGISTRY=ghcr.io/hasungje
GHCR_USER=
GHCR_PUSH_TOKEN=
GHCR_PULL_TOKEN=

# ── 인프라 공통 ────────────────────────────
# PostgreSQL · RabbitMQ · Redis 를 PC 포트로 열지(운영 0)
INFRA_EXPOSE=1

# ── PostgreSQL ─────────────────────────────
LOCAL_POSTGRES_PORT=5432
# (필수) 계정 — backend/.env.example 의 DATABASE_URL 과 같게
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless
# 백업 주기(cron, 한국 시각) · 보관 일수
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_KEEP_DAYS=7
# (관리형 RDS 만) 접속 주소 — 비우면 클러스터 안 postgres
DATABASE_URL=

# ── RabbitMQ ───────────────────────────────
# 브로커 · 관리 화면 PC 포트
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_ADMIN_PORT=15672
# (필수) 관리자 — 앱 계정 비밀번호는 backend/.env 의 RABBITMQ_*_PASSWORD
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# (관리형 Amazon MQ 만) 주소 — 비우면 클러스터 안 rabbitmq
RABBITMQ_HOST=
RABBITMQ_PORT=

# ── Redis ──────────────────────────────────
LOCAL_REDIS_PORT=6379
# (필수) 비밀번호 — backend/.env.example 의 REDIS_URL 과 같게
REDIS_PASSWORD=deskless
# (관리형 ElastiCache 만) 주소 — 비우면 클러스터 안 redis
REDIS_URL=

# ── gateway ────────────────────────────────
LOCAL_GATEWAY_PORT=13000
# PC 포트로 열지(운영 0 + GATEWAY_HOST)
GATEWAY_EXPOSE=1
# 공개 주소 — 로컬은 비운다(http://localhost:<LOCAL_GATEWAY_PORT>), 운영 (필수) https://api.<도메인>
GATEWAY_PUBLIC_URL=
# (운영) 도메인 · TLS 인증서 Secret
GATEWAY_HOST=
GATEWAY_TLS_SECRET=
# 대수 최소 · 최대(다르면 자동 증설)
GATEWAY_REPLICAS_MIN=2
GATEWAY_REPLICAS_MAX=4

# ── user-service · admin-service · scheduler ──
# 대수 최소 · 최대(scheduler 는 늘려도 작업은 회차마다 1대)
USER_SERVICE_REPLICAS_MIN=2
USER_SERVICE_REPLICAS_MAX=4
ADMIN_SERVICE_REPLICAS_MIN=1
ADMIN_SERVICE_REPLICAS_MAX=1
SCHEDULER_REPLICAS_MIN=1
SCHEDULER_REPLICAS_MAX=1

# ── web ────────────────────────────────────
LOCAL_WEB_PORT=15000
# PC 포트로 열지(운영 0 + WEB_HOST)
WEB_EXPOSE=1
# 공개 주소 — 로컬은 비운다(http://localhost:<LOCAL_WEB_PORT>), 운영 (필수) https://<도메인>
WEB_PUBLIC_URL=
# (운영) 도메인 · TLS 인증서 Secret
WEB_HOST=
WEB_TLS_SECRET=
# 대수 최소 · 최대
WEB_REPLICAS_MIN=2
WEB_REPLICAS_MAX=4

# ── 모니터링 ───────────────────────────────
# Grafana · Prometheus 를 PC 포트로 열지(운영 0 — port-forward)
MONITORING_EXPOSE=1
# Grafana — PC 포트 · (필수) 관리자(비밀번호는 첫 설치 때만 적용)
LOCAL_GRAFANA_PORT=13001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=deskless
# Prometheus — PC 포트 · 지표 보관 기간
LOCAL_PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION=30d

# ── 쿠버네티스 대시보드 ────────────────────
LOCAL_DASHBOARD_PORT=14466
# PC 포트로 열지(운영 0 — port-forward)
DASHBOARD_EXPOSE=1
# (필수) 로그인 계정(: 금지) — 바꾸면 다음 up 에 적용
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=deskless

# ── 이 서버(운영 리눅스 — ./deskless-server.sh) ──
# setup 이 깔 버전(k3s 는 비우면 안정 채널)
K3S_VERSION=
HELM_VERSION=v4.3.2
NERDCTL_VERSION=2.0.3
# k3s kubeconfig · containerd 소켓
KUBECONFIG_FILE=/etc/rancher/k3s/k3s.yaml
K3S_CONTAINERD_SOCKET=/run/k3s/containerd/containerd.sock
