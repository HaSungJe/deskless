# deskless 설정 — ./deskless.sh(Windows 는 deskless.cmd)가 읽는다. 키마다의 뜻은 docs/kubernetes.md · README
# 여기는 클러스터 몫(이 PC 실행 환경 · 대상 클러스터 · 공개 주소 · 인프라 계정 · 백업 · 앱 대수 · 모니터링)만 둔다.
# 백엔드 앱 값은 backend/.env, 프론트 값은 frontend/.env.production(없으면 frontend/.env) — 각 .env.example 을 복사(같은 값을 여기 다시 적지 않는다)
# (필수) 가 붙은 값이 비어 있거나, 이 예시에 새로 생긴 키가 .env 에 없으면 원클릭(./deskless.sh up)이 클러스터에 닿기 전에 멈춘다
#
# ⚠ 이 PC 로컬 클러스터(k3d)용 기본값이 들어 있다 — cp .env.example .env 만으로 로컬에서 돈다
#   (backend/.env 는 backend/.env.example 복사 그대로, frontend/.env.production 은 복사 뒤 NEXTAUTH_SECRET 만 채운다).
#   다른 PC · 사용자는 맨 위 "이 PC" 절만 그 환경에 맞게 고친다 — 실행 파일에는 PC 마다 다른 값을 적지 않는다.
#   서버(운영)에 올릴 때는 반드시 바꾼다:
#   - (필수) 비밀번호를 모두 새로 만든다 — POSTGRES_PASSWORD · RABBITMQ_PASSWORD · REDIS_PASSWORD · GRAFANA_ADMIN_PASSWORD
#     (데이터 폴더가 빌 때 한 번만 적용된다 — 나중에 바꾸기는 docs/kubernetes.md "비밀번호 바꾸기")
#   - KUBE_CONTEXT 를 운영 클러스터로 · 공개 주소를 도메인으로(GATEWAY_PUBLIC_URL · WEB_PUBLIC_URL)
#   - INFRA_EXPOSE=0 · GATEWAY_EXPOSE=0 + GATEWAY_HOST · WEB_EXPOSE=0 + WEB_HOST · MONITORING_EXPOSE=0
#   - backend/.env · frontend/.env.production 도 운영 값으로(비밀값 새로 · SEED_SAMPLE_DATA=0 · TRUST_PROXY=1 — docs/kubernetes.md "운영 서버")

# ── 이 PC — 실행 환경(PC · 사용자마다 다르다) ──
# 실행 파일(deskless.sh · deskless.cmd)은 이런 값을 고정하지 않고 여기서 읽는다 — 다른 PC 는 이 절만 고쳐 같은 실행 · 확인을 한다.
# 기본값은 Windows 11 + Docker Desktop(WSL2, cgroup v1) + Git for Windows 기본 설치 PC 기준. 리눅스 서버(운영)는 이 절을 쓰지 않는다(키는 남겨 둔다 — WAIT_TIMEOUT_MINUTES 만 쓴다).
# (Windows) Git Bash — deskless.cmd 가 이걸로 deskless.sh 를 돌린다(Git for Windows 설치 위치)
GIT_BASH=C:\Program Files\Git\bin\bash.exe
# (Windows) Docker Desktop 실행 파일 — 엔진이 꺼져 있으면 원클릭이 켠다(비우면 켜지 않고 멈춘다). 옆 resources\bin 의 docker · kubectl 도 PATH 에 없으면 여기서 찾는다
DOCKER_DESKTOP_EXE=C:\Program Files\Docker\Docker\Docker Desktop.exe
# 로컬 클러스터의 데이터 볼륨(Docker 볼륨 — 클러스터를 지워도 남는다. 이름을 바꾸면 새 빈 데이터로 시작한다)
LOCAL_DATA_VOLUME=deskless-infra-data
# 로컬 클러스터가 PC 127.0.0.1 에 여는 포트 — 다른 프로그램과 겹치면 바꾼다(바꾼 뒤에는 k3d cluster delete <이름> 후 다시 up — 데이터는 남는다).
# 게이트웨이 · 웹 · Grafana · Prometheus 는 앱 포트(3000 · 5000 · 3001 · 9090) 앞에 1 — PC 에서 npm 으로 띄우는 3000 · 5000 과 부딪히지 않게
LOCAL_GATEWAY_PORT=13000
LOCAL_WEB_PORT=15000
LOCAL_GRAFANA_PORT=13001
LOCAL_PROMETHEUS_PORT=19090
# 인프라 — PC 에서 npm 으로 띄우는 백엔드(작업 폴더 .env)의 접속 주소 · DB 도구가 붙는 포트(백엔드 .env.example 의 localhost 주소와 같게)
LOCAL_POSTGRES_PORT=5432
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_ADMIN_PORT=15672
LOCAL_REDIS_PORT=6379
# 쿠버네티스 API — kubectl 이 붙는 포트(127.0.0.1 에만 연다)
LOCAL_API_PORT=6550
# 로컬 k3s 에 더 줄 인자(공백으로 여러 개) — cgroup v1 PC(Docker Desktop · WSL2 커널 5.15)는 아래 값이 있어야 k3s 1.35 가 뜬다. docker info 의 Cgroup Version 이 2 면 비워도 된다
LOCAL_K3S_ARGS=--kubelet-arg=fail-cgroupv1=false@server:*
# 기다리는 시간 — 느린 PC 면 늘린다. Docker Desktop 켜기 · 노드 준비(초)
LOCAL_START_TIMEOUT_SECONDS=180
# Helm 설치 · 백업 · 마이그레이션 작업(분) — 첫 설치는 이미지를 받느라 오래 걸린다(서버에서도 쓴다)
WAIT_TIMEOUT_MINUTES=15

# ── 대상 클러스터 ───────────────────────────
# (필수) 모든 명령이 이 kubectl 컨텍스트에만 닿는다 — k3d-<이름> 이면 로컬 클러스터(원클릭이 없으면 <이름> 으로 만든다)
KUBE_CONTEXT=k3d-deskless

# ── 공개 주소 ───────────────────────────────
# 브라우저가 닿는 게이트웨이 · 웹 주소(끝의 / 없이) — 백엔드 GATEWAY_PUBLIC_URL · CORS_ORIGINS · USER_WEB_URL, 프론트 NEXT_PUBLIC_API_URL · NEXT_PUBLIC_SERVER_URL · NEXTAUTH_URL 에 넣는다
# 로컬은 비워 둔다 — http://localhost:<LOCAL_GATEWAY_PORT> · <LOCAL_WEB_PORT> 가 된다(포트를 두 번 적지 않는다). 운영은 (필수) https://api.<도메인> · https://<도메인>
# backend/.env · frontend/.env 의 같은 주소(PC 에서 npm 으로 띄울 때의 3000 · 5000)는 쓰지 않는다
GATEWAY_PUBLIC_URL=
WEB_PUBLIC_URL=

# ── 인프라 (PostgreSQL · RabbitMQ · Redis) ──
# 밖(노드 포트)으로 열지 — 1 이면 PostgreSQL · RabbitMQ · Redis 를 연다(로컬 k3d 는 PC 127.0.0.1 의 LOCAL_*_PORT 로 넘긴다). 운영은 0
INFRA_EXPOSE=1
# 노드의 데이터 · 백업 폴더(아래에 postgres · rabbitmq · redis · backups/postgres · files · prometheus · grafana) — 로컬은 k3d 가 LOCAL_DATA_VOLUME 을 이 자리에 붙인다
INFRA_DATA_DIR=/var/lib/deskless
# (필수) PostgreSQL — 로컬 기본값은 backend/.env.example 의 DATABASE_URL(postgresql://deskless:deskless@localhost:5432/deskless)과 같다
# 클러스터 안 백엔드의 DATABASE_URL 은 이 계정으로 deskless.sh 가 만든다(backend/.env 의 localhost 주소는 쓰지 않는다)
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless
# 백업 주기(cron 식, 한국 시각) · 보관 일수 — 같은 서버 안에만 쌓는다(내부 복구용)
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_KEEP_DAYS=7
# (필수) RabbitMQ 관리자 — 관리 화면 · 앱 계정 작업 전용(앱은 쓰지 않는다). 로컬 기본값은 backend/.env.example 의 RABBITMQ_USER · RABBITMQ_PASSWORD(npm run broker:check 용)와 같다
# 앱 계정 3개(gateway · user-service · admin-service)의 비밀번호는 backend/.env 의 RABBITMQ_*_PASSWORD 를 그대로 쓴다(큰따옴표 · 역슬래시는 쓰지 않는다)
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# (필수) Redis — 로컬 기본값은 backend/.env.example 의 REDIS_URL(redis://:deskless@localhost:6379)의 비밀번호와 같다
REDIS_PASSWORD=deskless

# ── 백엔드 앱 (gateway · user-service · admin-service · scheduler) ──
# ./deskless.sh backend up — deskless 에 받아 둔 backend/ 커밋으로 이미지를 빌드해 로컬 k3d 에 넣고 설치한다(마이그레이션이 앱보다 먼저)
# 대수 — 앱마다 최소 · 최대. 최소 < 최대면 CPU 사용률로 그 사이에서 자동 증설, 같으면 그 대수로 고정. 로컬 PC 가 무거우면 최대를 낮춘다
GATEWAY_REPLICAS_MIN=2
GATEWAY_REPLICAS_MAX=4
USER_SERVICE_REPLICAS_MIN=2
USER_SERVICE_REPLICAS_MAX=4
ADMIN_SERVICE_REPLICAS_MIN=1
ADMIN_SERVICE_REPLICAS_MAX=1
# scheduler 는 늘려도 crontab 이 회차마다 1대만 돈다(JobLockService)
SCHEDULER_REPLICAS_MIN=1
SCHEDULER_REPLICAS_MAX=1
# 자동 증설 기준 — CPU 코어 1개의 몇 %(대시보드 부하율 70% 와 같은 뜻, 프론트도 같다)
AUTOSCALE_CPU_PERCENT=70
# 게이트웨이를 밖으로 — 1 이면 Service 3000 을 노드 포트로(로컬 k3d 가 PC 의 LOCAL_GATEWAY_PORT 로 넘긴다). 운영은 0 + GATEWAY_HOST
GATEWAY_EXPOSE=1

# ── 프론트 (web) ────────────────────────────
# ./deskless.sh web up — 프론트 값 파일은 frontend/.env.production(없으면 frontend/.env — frontend/.env.example 복사, NEXTAUTH_SECRET 은 채운다)
# 대수 — 최소 < 최대면 CPU 사용률로 자동 증설(기준은 위 AUTOSCALE_CPU_PERCENT)
WEB_REPLICAS_MIN=2
WEB_REPLICAS_MAX=4
# 웹을 밖으로 — 1 이면 Service 5000 을 노드 포트로(로컬 k3d 가 PC 의 LOCAL_WEB_PORT 로 넘긴다). 운영은 0 + WEB_HOST
WEB_EXPOSE=1

# ── 모니터링 (Prometheus · Grafana · 수집기) ──
# ./deskless.sh monitoring up — 옛 backend compose.monitoring.yml 과 같은 구성(대시보드 2개 · 기록 규칙)
# 밖으로 열지 — 1 이면 Grafana · Prometheus 를 노드 포트로(로컬 k3d 가 PC 의 LOCAL_GRAFANA_PORT · LOCAL_PROMETHEUS_PORT 로 넘긴다). 운영은 0 — kubectl port-forward 로 본다
MONITORING_EXPOSE=1
# (필수) Grafana 관리자 — 비밀번호는 처음 설치할 때만 적용된다(Grafana 데이터 폴더가 빌 때). 운영은 새로 만든다
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=deskless
# 지표 보관 기간
PROMETHEUS_RETENTION=30d

# ── 운영에서만 (로컬은 비워 둔다) ───────────
# 게이트웨이 · 웹 공개 도메인(예: api.example.com · example.com) — 있으면 Ingress. INGRESS_CLASS 를 비우면 클러스터 기본(k3s 는 Traefik), *_TLS_SECRET 은 https 인증서 Secret 이름
GATEWAY_HOST=
GATEWAY_TLS_SECRET=
WEB_HOST=
WEB_TLS_SECRET=
INGRESS_CLASS=
# 관리형 서비스(RDS · ElastiCache · Amazon MQ)를 쓸 때만 — 비우면 위 인프라(postgres · redis · rabbitmq Service)로 deskless.sh 가 만든다
DATABASE_URL=
REDIS_URL=
RABBITMQ_HOST=
RABBITMQ_PORT=
