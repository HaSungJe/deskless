# deskless 설정 — 이 파일을 .env 로 복사해 쓴다(.env 는 커밋하지 않는다). ./deskless.sh 가 읽는다
# 아래 값은 로컬(k3d) 기본값이다 — 백엔드 .env.example 의 접속 주소 · 계정과 같아서 그대로 npm run start:* 가 붙는다.
#
# ⚠ 운영 서버는 첫 설치 전에
#   - 비밀번호를 모두 바꾼다(계정 · 비밀번호는 데이터 폴더가 빌 때 한 번만 적용된다 — 나중에 바꾸기는 README "비밀번호 바꾸기")
#   - INFRA_EXPOSE=0 (DB · 브로커 · Redis 포트를 밖으로 열지 않는다)
#   - KUBE_CONTEXT 를 운영 클러스터로

# ── 대상 클러스터 ───────────────────────────
# (필수) 모든 명령이 이 kubectl 컨텍스트에만 닿는다 — 로컬 k3d 클러스터 deskless 는 k3d-deskless
KUBE_CONTEXT=k3d-deskless

# ── 인프라 (PostgreSQL · RabbitMQ · Redis) ──
# 밖(노드 포트)으로 열지 — 1 이면 5432 · 5672 · 15672 · 6379 를 연다(로컬 k3d 는 PC 127.0.0.1 로 넘긴다). 운영은 0
INFRA_EXPOSE=1
# 노드의 데이터 · 백업 폴더(아래에 postgres · rabbitmq · redis · backups/postgres) — 로컬은 k3d 가 Docker 볼륨 deskless-infra-data 를 이 자리에 붙인다
INFRA_DATA_DIR=/var/lib/deskless

# ── PostgreSQL ──────────────────────────────
# (필수) 백엔드 DATABASE_URL 과 같게 — postgresql://<USER>:<PASSWORD>@localhost:5432/<DB>
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless
# 백업 주기(cron 식, 한국 시각) · 보관 일수 — 같은 서버 안에만 쌓는다(내부 복구용)
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_KEEP_DAYS=7

# ── RabbitMQ ────────────────────────────────
# (필수) 관리자 — 관리 화면 · 앱 계정 작업 전용(앱은 쓰지 않는다). 백엔드 RABBITMQ_USER · RABBITMQ_PASSWORD(npm run broker:check)와 같게
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# (필수) 앱 계정 비밀번호 — 백엔드 .env 의 같은 키와 같게. 큰따옴표 · 역슬래시는 쓰지 않는다
RABBITMQ_GATEWAY_PASSWORD=local-gateway-pw
RABBITMQ_USER_SERVICE_PASSWORD=local-user-service-pw
RABBITMQ_ADMIN_SERVICE_PASSWORD=local-admin-service-pw

# ── Redis ───────────────────────────────────
# (필수) 백엔드 REDIS_URL 과 같게 — redis://:<PASSWORD>@localhost:6379
REDIS_PASSWORD=deskless
