# deskless 설정 — ./deskless.sh 가 읽는다. 키마다의 뜻은 docs/kubernetes.md · README
# 여기는 클러스터 몫(대상 클러스터 · 인프라 계정 · 백업 · 앱 대수 · 공개 주소)만 둔다.
# 백엔드 앱 값(비밀값 · 설정 · 브로커 앱 계정 비밀번호)은 backend/.env 에서 읽는다 — backend/.env.example 을 복사(같은 값을 여기 다시 적지 않는다)
# (필수) 가 붙은 값이 비어 있으면 ./deskless.sh 가 클러스터에 닿기 전에 멈춘다
#
# ⚠ 로컬 클러스터(k3d)용 기본값이 들어 있다 — cp .env.example .env 만으로 로컬에서 돈다(backend/.env 도 backend/.env.example 복사 그대로).
#   - 인프라 계정은 backend/.env.example 의 접속 주소와 같은 값(deskless · deskless)이라 PC 에서 npm run start:* 로 띄운 백엔드도 그대로 붙는다
#   - 공개 주소는 backend · frontend .env.example 의 3000 · 5000 앞에 1 을 붙인 13000 · 15000 — 로컬 클러스터를 만들 때 연 포트(README)
#   서버(운영)에 올릴 때는 반드시 바꾼다:
#   - (필수) 비밀번호를 모두 새로 만든다 — POSTGRES_PASSWORD · RABBITMQ_PASSWORD · REDIS_PASSWORD
#     (데이터 폴더가 빌 때 한 번만 적용된다 — 나중에 바꾸기는 README "비밀번호 바꾸기")
#   - KUBE_CONTEXT 를 운영 클러스터로
#   - INFRA_EXPOSE=0 · GATEWAY_EXPOSE=0 + GATEWAY_HOST, 공개 주소를 실제 도메인으로(GATEWAY_PUBLIC_URL · WEB_PUBLIC_URL)
#   - backend/.env 도 운영 값으로(비밀값 새로 · SEED_SAMPLE_DATA=0 · TRUST_PROXY=1 — README "운영")

# ── 대상 클러스터 ───────────────────────────
# (필수) 모든 명령이 이 kubectl 컨텍스트에만 닿는다 — README 명령으로 만든 로컬 k3d 클러스터 deskless 는 k3d-deskless
KUBE_CONTEXT=k3d-deskless

# ── 인프라 공통 ─────────────────────────────
# 밖(노드 포트)으로 열지 — 1 이면 5432 · 5672 · 15672 · 6379 를 연다(로컬 k3d 는 PC 127.0.0.1 로 넘긴다 — 백엔드 .env.example 의 localhost 주소). 운영은 0
INFRA_EXPOSE=1
# 노드의 데이터 · 백업 폴더(아래에 postgres · rabbitmq · redis · backups/postgres) — 로컬은 k3d 가 Docker 볼륨 deskless-infra-data 를 이 자리에 붙인다
INFRA_DATA_DIR=/var/lib/deskless

# ── PostgreSQL ──────────────────────────────
# (필수) 로컬 기본값은 backend/.env.example 의 DATABASE_URL(postgresql://deskless:deskless@localhost:5432/deskless)과 같다
# 클러스터 안 백엔드의 DATABASE_URL 은 이 계정으로 deskless.sh 가 만든다(backend/.env 의 localhost 주소는 쓰지 않는다)
POSTGRES_USER=deskless
POSTGRES_PASSWORD=deskless
POSTGRES_DB=deskless
# 백업 주기(cron 식, 한국 시각) · 보관 일수 — 같은 서버 안에만 쌓는다(내부 복구용)
POSTGRES_BACKUP_SCHEDULE=0 3 * * *
POSTGRES_BACKUP_KEEP_DAYS=7

# ── RabbitMQ ────────────────────────────────
# (필수) 관리자 — 관리 화면(http://localhost:15672) · 앱 계정 작업 전용(앱은 쓰지 않는다)
# 로컬 기본값은 backend/.env.example 의 RABBITMQ_USER · RABBITMQ_PASSWORD(npm run broker:check 용 — deskless · deskless)와 같다
RABBITMQ_USER=deskless
RABBITMQ_PASSWORD=deskless
# 앱 계정 3개(gateway · user-service · admin-service)의 비밀번호는 backend/.env 의 RABBITMQ_*_PASSWORD 를 그대로 쓴다(큰따옴표 · 역슬래시는 쓰지 않는다)

# ── Redis ───────────────────────────────────
# (필수) 로컬 기본값은 backend/.env.example 의 REDIS_URL(redis://:deskless@localhost:6379)의 비밀번호와 같다
REDIS_PASSWORD=deskless

# ── 백엔드 앱 대수 (gateway · user-service · admin-service · scheduler) ──
# ./deskless.sh backend up — deskless 에 받아 둔 backend/ 커밋으로 이미지를 빌드해 로컬 k3d 에 넣고 설치한다(마이그레이션이 앱보다 먼저)
# 앱마다 최소 · 최대 — 최소 < 최대면 CPU 사용률로 그 사이에서 자동 증설, 같으면 그 대수로 고정(비우면 아래 기본값)
# 로컬 PC 가 무거우면 최대를 낮춘다
GATEWAY_REPLICAS_MIN=2
GATEWAY_REPLICAS_MAX=4
USER_SERVICE_REPLICAS_MIN=2
USER_SERVICE_REPLICAS_MAX=4
ADMIN_SERVICE_REPLICAS_MIN=1
ADMIN_SERVICE_REPLICAS_MAX=1
# scheduler 는 늘려도 crontab 이 회차마다 1대만 돈다(JobLockService)
SCHEDULER_REPLICAS_MIN=1
SCHEDULER_REPLICAS_MAX=1
# 자동 증설 기준 — CPU 코어 1개의 몇 %(대시보드 부하율 70% 와 같은 뜻)
AUTOSCALE_CPU_PERCENT=70

# ── 공개 주소 ───────────────────────────────
# (필수, 끝의 / 없이) 브라우저가 닿는 게이트웨이 · 웹 주소 — 백엔드 GATEWAY_PUBLIC_URL · CORS_ORIGINS · USER_WEB_URL 에 넣는다(웹 주소는 Phase 4 에서 프론트 주소 키에도)
# backend/.env · frontend/.env 의 같은 주소(PC 에서 npm 으로 띄울 때의 3000 · 5000)는 쓰지 않는다
# 로컬은 백엔드 GATEWAY_PUBLIC_URL(:3000) · 프론트 NEXT_PUBLIC_SERVER_URL(:5000) 앞에 1 — 운영은 https://api.<도메인> · https://<도메인>
GATEWAY_PUBLIC_URL=http://localhost:13000
WEB_PUBLIC_URL=http://localhost:15000
# 게이트웨이를 밖으로 — 1 이면 Service 3000 을 노드 포트로(로컬 k3d 가 PC 127.0.0.1:13000 으로 넘긴다). 운영은 0 + GATEWAY_HOST
GATEWAY_EXPOSE=1

# ── 운영에서만 (로컬은 비워 둔다) ───────────
# 게이트웨이 공개 도메인(예: api.example.com) — 있으면 Ingress. INGRESS_CLASS 를 비우면 클러스터 기본(k3s 는 Traefik), GATEWAY_TLS_SECRET 은 https 인증서 Secret 이름
GATEWAY_HOST=
INGRESS_CLASS=
GATEWAY_TLS_SECRET=
# 관리형 서비스(RDS · ElastiCache · Amazon MQ)를 쓸 때만 — 비우면 위 인프라(postgres · redis · rabbitmq Service)로 deskless.sh 가 만든다
DATABASE_URL=
REDIS_URL=
RABBITMQ_HOST=
RABBITMQ_PORT=
